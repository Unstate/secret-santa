www.{$DOMAIN:localhost} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN:localhost} {
	root * /srv
	encode gzip zstd

	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	@backend path /api/* /healthz
	handle @backend {
		reverse_proxy backend:8080
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
